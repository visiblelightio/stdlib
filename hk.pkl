amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

steps {
  ["hk-validate"] {
    check = new CommandSpec {
      command = "hk validate --deny-warnings"
      effect = "read"
    }
  }
  ["woodpecker-lint"] {
    check = new CommandSpec {
      command = "mise run ci:lint"
      effect = "read"
    }
  }
  ["shell-tests"] {
    check = new CommandSpec {
      command = "mise run hooks:test"
      effect = "read"
    }
  }
  ["terraform"] = Builtins.terraform
  ["oxfmt"] = Builtins.oxfmt
  ["package-typecheck"] {
    check = new CommandSpec {
      command = "npm run typecheck"
      effect = "read"
    }
  }
  ["oxlint"] {
    glob = List("**/*.ts")
    check = new CommandSpec {
      command = "npm run lint"
      effect = "read"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["final-newline"] = Builtins.newlines
}

hooks {
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] {
        check = new CommandSpec {
          command = new Command {
            argv = List("mise", "run", "hooks:check-commit-message", "{{commit_msg_file}}")
          }
          effect = "read"
        }
      }
    }
  }
}
